<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme - Google Stitch Light Mode (Warm Tactile Editorial) -->
    <style name="Theme.SmartExpenseTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/background</item>
        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <!-- Error -->
        <item name="colorError">@color/error</item>
        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.SmartExpenseTracker.Splash" parent="Theme.SmartExpenseTracker">
        <item name="android:statusBarColor">#090D19</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">#090D19</item>
    </style>

    <!-- Card Style matching Google Stitch rounded tactile cards -->
    <style name="Widget.SmartExpense.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">1dp</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.SmartExpense.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="Widget.SmartExpense.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:backgroundTint">@color/surface_variant</item>
    </style>

    <!-- Input Field Style -->
    <style name="Widget.SmartExpense.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.SmartExpense.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="android:background">@color/background</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.SmartExpense.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.SmartExpense.Title</item>
        <item name="android:background">@color/background</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Typography Styles -->
    <style name="TextAppearance.SmartExpense.Display" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.SmartExpense.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.SmartExpense.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.SmartExpense.Amount" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">32sp</item>
    </style>

    <!-- FAB Style -->
    <style name="Widget.SmartExpense.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/text_on_primary</item>
        <item name="elevation">6dp</item>
    </style>

    <!-- Chip Style -->
    <style name="Widget.SmartExpense.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">16dp</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">true</item>
        <item name="chipBackgroundColor">@color/surface</item>
    </style>

    <!-- Dialog Style -->
    <style name="Widget.SmartExpense.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- Snackbar -->
    <style name="Widget.SmartExpense.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/primary_dark</item>
        <item name="actionTextColorAlpha">1</item>
        <item name="snackbarButtonStyle">@style/Widget.Material3.Button.TextButton.Snackbar</item>
    </style>
</resources>
